      "name": "Junctions",
      "item": [
        {
          "name": "List Junctions",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/junctions", "host": ["{{baseUrl}}"], "path": ["api", "junctions"] }
          }
        },
        {
          "name": "Create Junction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"junction_id\": \"B\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/junctions", "host": ["{{baseUrl}}"], "path": ["api", "junctions"] }
          }
        },
        {
          "name": "Get Junction Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/junctions/A/status", "host": ["{{baseUrl}}"], "path": ["api", "junctions", "A", "status"] }
          }
        },
        {
          "name": "Manual Green Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"command\": \"MANUAL_GREEN_REQUEST\",\n  \"direction\": \"EAST\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/junctions/A/commands", "host": ["{{baseUrl}}"], "path": ["api", "junctions", "A", "commands"] }
          }
        },
        {
          "name": "Return to Automatic",
